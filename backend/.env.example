# Copy this file to .env and fill in real values.
# Local dev: leave APP_ENV unset or set to "development" -> connects to local MongoDB.
# Render (production): set APP_ENV=production in Render's Environment tab -> connects to Atlas.

APP_ENV=development

# --- MongoDB Atlas (only required when APP_ENV=production) ---
MONGO_USER=
MONGO_PASS=
MONGO_CLUSTER=

# --- Flask ---
SECRET_KEY=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_ANALYZE_API_KEY=

# --- Cloudinary (book PDFs, profile pictures) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Brevo (transactional email) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# --- Misc ---
ABSTRACT_API_KEY=
MONITORING_API_KEY=
